# ==========================================================
# Variables de entorno del stack de seguridad
# ==========================================================
# Copiar a `.env` y sustituir. NUNCA subir el `.env` real:
# está en .gitignore y el job `secrets` de CI lo verifica.
#
#   cp .env.example .env
#
# Todas las credenciales de este fichero son de EJEMPLO.
# En un despliegue real, generar valores aleatorios:
#
#   openssl rand -hex 24
# ==========================================================

# ---------- Identidad del despliegue ----------
STACK_NAME=sentinel
COMPOSE_PROJECT_NAME=sentinel

# ---------- ClickHouse ----------
CLICKHOUSE_USER=sentinel_ingest
CLICKHOUSE_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
CLICKHOUSE_DB=security
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
# Usuario de solo lectura para los paneles de Grafana
CLICKHOUSE_RO_USER=sentinel_ro
CLICKHOUSE_RO_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ---------- Kafka ----------
KAFKA_BROKER=kafka
KAFKA_PORT=9092
KAFKA_TOPIC_PREFIX=security-logs

# ---------- Vector ----------
VECTOR_AGGREGATOR_PORT=8686

# ---------- CrowdSec ----------
CROWDSEC_LAPI_URL=http://crowdsec:8080
# API key del bouncer: `cscli bouncers add <nombre>`
CROWDSEC_BOUNCER_API_KEY=CHANGE_ME_generated_by_cscli
CROWDSEC_BOUNCER_NAME=firewall-bouncer-edge

# ---------- Coraza / WAF ----------
# Secreto compartido que permite a una fuente de datos externa
# atravesar el WAF. NUNCA en claro: es la llave que desactiva
# las detecciones SQLi/XSS/RCE/LFI para quien la presente.
CORAZA_INGEST_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---------- Grafana / Prometheus ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ---------- Dominios de ejemplo ----------
# Sustituir por los dominios reales en un despliegue productive.
EXAMPLE_DOMAIN=app.example.com
EXAMPLE_API_DOMAIN=api.example.com

# ---------- Red ----------
# Rangos internos genericos (sustituir por los reales)
SUBNET_PERIMETER=192.168.10.0/24
SUBNET_SERVICES=192.168.20.0/24
SUBNET_DATA=192.168.30.0/24
